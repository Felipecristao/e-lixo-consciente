NODE_ENV=development
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_ROOT_PASSWORD=troque-a-senha-root-local
DB_USER=elixo
DB_PASSWORD=troque-esta-senha
DB_NAME=elixo
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5500,http://127.0.0.1:5500

# E-mail de recuperacao de senha (deixe em branco para desativar o envio real
# e apenas ver o link de teste no retorno da API em desenvolvimento).
# Exemplo com Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587,
# EMAIL_USER=seuemail@gmail.com, EMAIL_PASS=senha-de-app-do-gmail
# (nao use a senha normal da conta Google, gere uma "senha de app").
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Base usada para montar o link de redefinicao de senha no e-mail.
# Se vazio, usa automaticamente o host da propria requisicao.
FRONTEND_URL=
