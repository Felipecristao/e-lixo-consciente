# Copie para .env.production somente na VPS e substitua todos os valores.
DOMAIN=elixoconsciente.com.br
ACME_EMAIL=seu-email@exemplo.com

DB_USER=elixo_app
DB_PASSWORD=gere-uma-senha-longa-e-aleatoria
DB_ROOT_PASSWORD=gere-outra-senha-longa-e-aleatoria

JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=7d

# E-mail de recuperacao de senha (obrigatorio para o "esqueci minha senha"
# enviar de verdade aos usuarios; sem isso o link nao e enviado a ninguem).
# Exemplo com Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587,
# EMAIL_USER=seuemail@gmail.com, EMAIL_PASS=senha-de-app-do-gmail
# (gere uma "senha de app" em https://myaccount.google.com/apppasswords,
# nao use a senha normal da conta Google).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seuemail@gmail.com
EMAIL_PASS=gere-uma-senha-de-app-do-gmail
EMAIL_FROM=seuemail@gmail.com
